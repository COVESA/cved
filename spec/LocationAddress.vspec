#
# This file contains the Location Address data.
#

LocationAddress:
  type: branch
  description: Branch containing Location Address data.

LocationAddress.StreetNumber:
  type: rw
  datatype: uint32
  description: "A number that identifies a particular unit or location within a street. Format: Numeric."

LocationAddress.StreetPreDirectional:
  type: rw
  datatype: string
  description: "A direction that appears before a street name. Format: Alpha."

LocationAddress.StreetName:
  type: rw
  datatype: string
  description: "A name of a street. Format: Text."

LocationAddress.StreetType:
  type: rw
  datatype: string
  description: "A kind of street. Format: Text."

LocationAddress.StreetPostDirectionalText:
  type: rw
  datatype: string
  description: "A direction that appears after a street name. Format: Text."
