#
# This file contains the Emergency Contact Information data.
#

EmergencyContactInformation:
  type: branch
  description: Branch containing Emergency Contact Information data.

EmergencyContactInformation.ContactID:
  type: rw
  datatype: uint32
  description: "ID for each emergency contact, 0 to infinity. Format: Numeric."

EmergencyContactInformation.EmergencyContactName:
  type: rw
  datatype: string
  description: "Name of Emergency Contact. Format: Text."

EmergencyContactInformation.Emergency ContactAddressFullText:
  type: rw
  datatype: string
  description: "Full Address of Emergency Contact. Format: Text."

EmergencyContactInformation.EmergencyContactPrimaryDeviceID:
  type: rw
  datatype: string
  description: "Emergency contact primary contact device number identification, i.e., Telephone or pager. Format: NPA-NXX-LINE."
