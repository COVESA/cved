#
# This file contains the Registration data.
#

Registration:
  type: branch
  description: Branch containing Registration data.

Registration.PlateNumber:
  type: rw
  datatype: string
  description: "Indicates license plate number of vehicle. Format: Text."

Registration.PlateState:
  type: rw
  datatype: string
  description: "Indicates the license plate state. Values: State abbreviation (United States and Mexico), Canadian province, otherwise full value if other location. Format: Text."
