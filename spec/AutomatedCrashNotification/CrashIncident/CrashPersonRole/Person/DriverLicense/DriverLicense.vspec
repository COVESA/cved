#
# This file contains the DriverLicense data.
#

DriverLicense:
  type: branch
  description: Branch containing DriverLicense data.

DriverLicense.DriverLicenseID:
  type: rw
  datatype: string
  description: "Driver License Number. (If applicable) Format: Text."

DriverLicense.DriverLicenseState:
  type: rw
  datatype: string
  description: "Driver's License State or Province (If applicable). Format: Text."
