#
# This file contains the Occupants data.
#

Occupants:
  type: branch
  description: Branch containing occupants data.

Occupants.NumOfOccupants:
  type: rw
  datatype: uint8
  description: Number of vehicle occupants

##include CrashPersonRole/CrashPersonRole.vspec Occupants  <- ersätt med struct array

Occupants.Occupant:
  type: rw
  datatype: Types.Occupant[]
  description: Array where each member contains data for one occupant
