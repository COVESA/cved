#
# This file contains the Airbag data.
#

Airbag:
  type: branch
  description: Branch containing Airbag data.

Airbag.AirbagCategoryCode:
  type: rw
  datatype: string
  allowed: ['FRONT', 'SIDE', 'CURTAIN', 'ROOF', 'SEAT']
  description: "Categorizes this airbag. Values: FRONT (front), SIDE (side), CURTAIN (curtain), ROOF (roof), SEAT (seat belt airbag). Format: Text."

Airbag.AirbagDeployedIndicator:
  type: rw
  datatype: boolean
  description: "Indicates if this airbag is deployed. Values: true, false."
