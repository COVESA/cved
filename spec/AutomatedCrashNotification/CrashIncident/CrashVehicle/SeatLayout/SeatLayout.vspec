#
# This file contains the Seat data.
#

Seat:
  type: branch
  description: Branch containing Seat data.

Seat.RowTotal:
  type: rw
  datatype: uint8
  description: The total number of vehicle seat rows

Seat.RowLayout:
  type: rw
  datatype: uint8[]
  description: Array containing the number of seats per row
