#
# This file contains the Agency Notified data.
#

AgencyNotified:
  type: branch
  description: Branch containing Agency Notified data.

AgencyNotified.AgencyName:
  type: rw
  datatype: string
  description: "Name of agency notified by incident originator. Format: Text."

AgencyNotified.OrganizationID:
  type: rw
  datatype: string
  description: "Unique identifier for the agency receiving the data. Typically, this could be a NLETS ORI, a NG9-1-1 agency identifier, or another identifier. May be a required field for certain data transmission layers. Format: Text."

AgencyNotified.EmployeeID:
  type: rw
  datatype: string
  description: "Identification number or name of individual at agency who received call. Format: Text."

#include ContactInformation/ContactInformation.vspec AgencyNotified

