#
# This file contains the Contact Information data.
#

ContactInformation:
  type: branch
  description: Branch containing Contact Information data.

ContactInformation.CountryCode:
  type: rw
  datatype: uint16
  description: "ITU-T Country Code if international. Format: Numeric."

ContactInformation.FullTelephoneNumber:
  type: rw
  datatype: string
  description: "7 X 24 telephone number to contact the originating agency / called to contact agency. Format: NPA-NXX-LINE."

ContactInformation.Contact DateTime:
  type: rw
  datatype: string
  description: "UTC date and time the notified agency was first contacted by incident originator. Value: CCYY-MM-DDThh:mm:ss.sss (concatenation of date and time, separated by a literal letter \"T\") as specified in xsd:dateTime."
