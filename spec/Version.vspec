#
# VSS Versioning information
#

Major:
  datatype: uint32
  type: attribute
  default: 0
  description: Major version.

Minor:
  datatype: uint32
  type: attribute
  default: 1
  description: Minor version.

Patch:
  datatype: uint32
  type: attribute
  default: 0
  description: Patch version.
