#
# This file contains the Crash Pulse data.
#

CrashPulse:
  type: branch
  description: Branch containing Crash Pulse data.

CrashPulse.ImpactID:
  type: rw
  datatype: string
  description: "Numerical and sequential impact identifier. Values: First, Second, Third, Forth, Fifth, Sixth, Seventh, Eight, Ninth, Tenth, (etc.). Format: Text."

CrashPulse.ChangeInVelocity:
  type: rw
  datatype: uint16
  min: 0
  max: 999
  description: "Force of impact based on the change in velocity over the duration of the crash pulse (measured in units of 0-999 KPH or MPH. Format: The KPH or MPH numeric value and the string \"MPH\" or \"KPH\"."

CrashPulse.ChangeInVelocityUnit:
  type: rw
  datatype: string
  allowed: ['MPH', 'KPH']
  description: "Unit of measure for the Change in Velocity value. Values: MPH, KPH."

CrashPulse.PrincipalDirectionOfForceText:
  type: rw
  datatype: uint8
  min: 1
  max: 12
  description: Principal direction of the force of the impact to nearest O'clock Reading (valid numbers are integers 1 through 12, where 12 O'clock corresponds to a frontal collision, 3 O'clock corresponds to a passenger side (right side) collision etc.

CrashPulse.RolloverQuarterTurnNumber:
  type: rw
  datatype: uint16
  min: 0
  description: "Number of quarter turns in concert with a rollover. Expressed as a non-negative integer. Format: Non-negative integer."

CrashPulse.RollBarDeployedIndicator:
  type: rw
  datatype: boolean
  description: "Is Roll Bar Deployed? Values: true, false."

CrashPulse.DigitalImageLocation:
  type: rw
  datatype: string
  description: "URL where digital image is available. Format: URL."

CrashPulse.RolloverIndicator:
  type: rw
  datatype: boolean
  description: "Indicates if the vehicle rolled over. Values: true, false."
