#
# This file contains the COVESA Vehicle Emergency Data set.
#

CVED:
  type: branch
  description: COVESA Vehicle Emergency Data Set.

#
# Include the legacy VEDS data set.
#
#include AutomatedCrashNotification/AutomatedCrashNotification.vspec CVED

#
# Include additional contextual data.
#
CVED.Context:
  type: branch
  description: Additional contextual data.

#include Context/Context.vspec CVED.Context

#
# Include the CVED version data.
#
CVED.Version:
  type: branch
  description: CVED version data.

#include Version/Version.vspec CVED.Version
